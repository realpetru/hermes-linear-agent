# Copy to .env ONLY for Docker Compose or `make dev`.
# A `hermes linear-agent serve` install takes its credentials from Hermes' profile
# secret scope (`hermes config set KEY <value>`, or `hermes plugins install ... --force`
# for masked prompts); the plugin never reads this file by itself.
# For a standalone service, name the file explicitly: LINEAR_AGENT_ENV_FILE=/path/to/.env
# chmod 600 .env
# NEVER commit the real .env.

# --- Linear OAuth app (Settings -> API -> Applications) ---------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# Public base URL of the bridge, no trailing slash. Linear posts to
#   <this>/webhook          (paste that into the app's Webhook URL field)
# The OAuth callback defaults to <this>/oauth/callback.
LINEAR_AGENT_PUBLIC_URL=https://YOUR-PUBLIC-HOST

# Browser-facing OAuth callback. Only set this when the browser finishing the install
# is not on the public host (e.g. a same-machine test). It must be byte-identical to a
# Callback URL on the app page. `localhost` and `127.0.0.1` are different strings.
# LINEAR_REDIRECT_URI=http://localhost:8650/oauth/callback

# --- Hermes side ------------------------------------------------------------
# gateway    = POST /v1/runs on the Hermes API server (required for Docker: the image
#              has no `hermes` binary). Needs API_SERVER_ENABLED=true + API_SERVER_KEY
#              on the Hermes host, and HERMES_GATEWAY_TOKEN set to that same key.
# subprocess = `hermes chat -q` (native installs only)
HERMES_ADAPTER=gateway
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_GATEWAY_TOKEN=

# --- Bridge -----------------------------------------------------------------
PORT=8650
BIND=127.0.0.1
MAX_CONCURRENCY=3
AGENT_DISPLAY_NAME=Hermes
LOG_LEVEL=INFO

# Absolute path recommended: a relative path is resolved against the process's working
# directory, so a service started elsewhere loses the token. 1.3.1 defaults to
# ~/.hermes/plugin-data/linear-agent/linear-tokens.json.
# Docker sets this to /data/linear-tokens.json in the image; leave it unset here.
# LINEAR_TOKEN_PATH=/home/you/.hermes/plugin-data/linear-agent/linear-tokens.json

# Keep state (dedupe, concurrency slots) somewhere that survives a reboot. 1.3.1 defaults
# to a file beside the token. Compose uses /data.
# STATE_DB=/home/you/.hermes/plugin-data/linear-agent/state.sqlite3

# When set, GET /status returns counters and the last error to
# `Authorization: Bearer <token>`; `hermes linear-agent status` shows detail either way.
STATUS_TOKEN=
