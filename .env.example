# Copy to .env, fill in, then: chmod 600 .env
# NEVER commit the real .env.

# Linear webhook signing secret (Linear -> Settings -> API -> your webhook)
LINEAR_WEBHOOK_SECRET=

# Linear API key. Create your OWN for local dev in Linear -> Settings -> API.
# Use a key scoped to this deployment, not a shared production key.
LINEAR_API_KEY=

# gateway  = POST /v1/runs on the Hermes API server (preferred)
# subprocess = `hermes chat -q` (fallback)
HERMES_ADAPTER=gateway
HERMES_GATEWAY_URL=http://127.0.0.1:8642
HERMES_GATEWAY_TOKEN=
HERMES_BIN=hermes

PORT=8650
BIND=127.0.0.1
MAX_CONCURRENCY=3
STATE_DB=/tmp/hermes-linear-agent/state.sqlite3
AGENT_DISPLAY_NAME=Hermes
LOG_LEVEL=INFO

# --- Linear OAuth app (create in Linear UI; see docs/INSTALL.md) ---
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:8650/oauth/callback
LINEAR_TOKEN_PATH=data/linear-tokens.json
